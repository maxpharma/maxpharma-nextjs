# Must be an ABSOLUTE URL, not a relative path like "/api" — this var is also
# read server-side (generateMetadata via src/utils/seo.ts, src/app/api/seo/route.ts),
# where a relative URL throws ERR_INVALID_URL for axios/fetch running in Node.
# Tradeoff: on Preview deployments this means preview traffic hits the
# production API unless overridden per-environment in Vercel's dashboard.
NEXT_PUBLIC_APP_BASE_URL=https://maxpharma.com.np/api
# Points directly at the DigitalOcean Spaces CDN (matches DIGITAL_BUCKET_URL
# below) rather than maxpharma.com.np — that domain only served /maxpharma/*
# via infrastructure in front of the old Bun backend, which disappears once
# it points at Vercel instead.
NEXT_PUBLIC_BUCKET_URL=https://iservers.blr1.cdn.digitaloceanspaces.com
API_KEY=hsdjhfjhehbdjrhjerhjkdhdjhfjkbrdhfjed

# Database (MySQL — via a serverless-safe pooler such as PlanetScale, or
# a pooling proxy in front of the existing MySQL server; see the design
# spec's Vercel Deployment Compatibility section)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=maxpharma
DB_USER=root
DB_PASS=password

JWT_SECRET=your_jwt_signing_secret_here
MODE=production

# DigitalOcean Spaces Storage
DIGITAL_SECRET_KEY=your_digitalocean_spaces_secret_key
DIGITAL_ACCESS_ID=your_digitalocean_spaces_access_key_id
DIGITAL_BUCKET_URL=https://iservers.blr1.cdn.digitaloceanspaces.com
DIGITAL_ENDPOINT=https://blr1.digitaloceanspaces.com
DIGITAL_BUCKET_NAME=iservers
DIGITAL_BUCKET_FOLDER=maxpharma
