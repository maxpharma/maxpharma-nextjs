{
  "name": "prabhusteels-backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"bun run --watch src/index.ts\" \"bun run --watch src/bucket.ts\"",
    "build": "bun build src/index.ts src/bucket.ts --outdir=dist --target node --external farmhash",
    "lint": "eslint src/**/*.ts --fix",
    "start": "concurrently \"bun run dist/index.js\" \"bun run dist/bucket.js\"",
    "migrate": "bun run src/migrations/index.ts",
    "seed": "bun run src/seeders/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@types/express": "^5.0.0",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/heic-convert": "^2.1.0",
    "@types/jsonwebtoken": "^9.0.9",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "elysia": "^1.2.22",
    "elysia-helmet": "^2.0.0",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "i": "^0.3.7",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "node-cache": "^5.1.2",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sharp": "^0.33.5"
  }
}